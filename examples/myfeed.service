# Run one myfeed pass, triggered by myfeed.timer.
#
#   mkdir -p ~/.config/systemd/user
#   cp examples/myfeed.{service,timer} ~/.config/systemd/user/
#   systemctl --user enable --now myfeed.timer
#   journalctl --user -u myfeed -f
#
# Put the API key in ~/.config/myfeed/env as:
#   ANTHROPIC_API_KEY=sk-ant-...
# and keep that file mode 600.

[Unit]
Description=Filter RSS feeds with myfeed
Documentation=https://github.com/your-org/myfeed
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/myfeed/env
ExecStart=%h/.local/bin/myfeed --config %h/.config/myfeed/myfeed.toml --once --verbose
# --once makes this a single pass; the timer below provides the schedule.
Nice=10
