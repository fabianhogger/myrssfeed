# Schedule for myrssfeed.service. See examples/myrssfeed.service for installation.

[Unit]
Description=Run myrssfeed every 30 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=30min
# Spread the run out a little so every machine does not hit the feeds at once.
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
